{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/tamas-labs/aura-schema/main/schema/footer.schema.json",
    "title": "Aura table footer",
    "description": "The footer block is optional, and is built from the same rows and cells as the header — it is validated by the very same validators.",
    "$defs": {
        "footer": {
            "description": "Footer block of the response.",
            "type": "object",
            "properties": {
                "rows": {
                    "description": "Footer rows, top to bottom. At least one row is required.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "./header.schema.json#/$defs/headerRow"
                    }
                },
                "settings": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/footerSettings"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": ["rows"],
            "additionalProperties": true
        },
        "footerSettings": {
            "description": "Footer-wide settings.",
            "type": "object",
            "properties": {
                "sticky": {
                    "description": "Keep the footer fixed to the bottom of the scroll container.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "height": {
                    "description": "Fixed footer height.",
                    "$ref": "./common.schema.json#/$defs/cssSize"
                }
            }
        }
    },
    "$ref": "#/$defs/footer"
}
