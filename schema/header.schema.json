{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/tamas-labs/aura-schema/main/schema/header.schema.json",
    "title": "Aura table header",
    "description": "The header is the only required part of the response — without it there are no columns to render.",
    "$defs": {
        "header": {
            "description": "Header block of the response.",
            "type": "object",
            "properties": {
                "rows": {
                    "description": "Header rows, top to bottom. At least one row is required; several rows build a grouped header.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/headerRow"
                    }
                },
                "settings": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/headerSettings"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": ["rows"],
            "additionalProperties": true
        },
        "headerRow": {
            "description": "One header row. Keys other than `cells` are dropped.",
            "type": "object",
            "properties": {
                "cells": {
                    "description": "Cells of the row, left to right. At least one is required.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/headerCell"
                    }
                }
            },
            "required": ["cells"],
            "additionalProperties": false
        },
        "headerCell": {
            "description": "One header cell — the definition of a column. A *data cell* names its source with `field` or `fields`; a *grouping cell* has neither and spans several columns with `colspan` > 1. Unknown keys are dropped, except `data-*` attributes, which are kept and rendered onto the `<th>`.",
            "type": "object",
            "properties": {
                "content": {
                    "description": "Column heading text. Required on every cell; `null` renders an empty heading.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "key": {
                    "description": "Unique column identifier — the key `body.columnConfigs` entries are looked up by, and the key used in session persistence. Defaults to `field` when only `field` is given; required when `fields` is used.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "field": {
                    "description": "Item field this column reads. Mutually exclusive with `fields`. Required on data cells (a grouping cell — one with `colspan` > 1 and no field — may omit it).",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "fields": {
                    "$ref": "./common.schema.json#/$defs/fields"
                },
                "label": {
                    "description": "Alternative heading text, kept for backwards compatibility.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 0,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "colspan": {
                    "$ref": "./common.schema.json#/$defs/colspan"
                },
                "rowspan": {
                    "$ref": "./common.schema.json#/$defs/rowspan"
                },
                "width": {
                    "$ref": "./common.schema.json#/$defs/cssSize"
                },
                "resizable": {
                    "description": "Allow the user to drag the column width.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "pad": {
                    "$ref": "./common.schema.json#/$defs/pad"
                },
                "padStart": {
                    "$ref": "./common.schema.json#/$defs/pad"
                },
                "padEnd": {
                    "$ref": "./common.schema.json#/$defs/pad"
                },
                "chars": {
                    "$ref": "./common.schema.json#/$defs/chars"
                },
                "sortable": {
                    "description": "Offer sorting on this column. Sorting is server-side: the field lands in the request’s `sortable` array.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "searchable": {
                    "description": "Offer the per-column search input. Server-side: the field lands in the request’s `searchable` array.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "filterable": {
                    "description": "Offer the per-column filter dropdown. Server-side: the field lands in the request’s `filterable` array.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "elements": {
                    "$ref": "./common.schema.json#/$defs/filterElements"
                },
                "selectable": {
                    "description": "Render row-selection checkboxes in this column. The chosen ids are sent as `selected`.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "show": {
                    "description": "Initial column visibility.",
                    "default": true,
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "between": {
                    "description": "Offer a range (min–max) search instead of a term search. Sends `min` / `max` in the request’s `searchable` entry.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "reference": {
                    "$ref": "./common.schema.json#/$defs/reference"
                },
                "align": {
                    "$ref": "./common.schema.json#/$defs/align"
                },
                "color": {
                    "description": "Heading text colour.",
                    "$ref": "./common.schema.json#/$defs/color"
                },
                "background": {
                    "description": "Heading background colour.",
                    "$ref": "./common.schema.json#/$defs/color"
                },
                "size": {
                    "$ref": "./common.schema.json#/$defs/size"
                },
                "fontSize": {
                    "$ref": "./common.schema.json#/$defs/fontSize"
                },
                "fontWeight": {
                    "$ref": "./common.schema.json#/$defs/fontWeight"
                },
                "italic": {
                    "description": "Italic heading text.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "normal": {
                    "description": "Reset italics (`font-style: normal`).",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "lineHeight": {
                    "$ref": "./common.schema.json#/$defs/lineHeight"
                },
                "monospace": {
                    "description": "Monospace heading font.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "text": {
                    "$ref": "./common.schema.json#/$defs/textUtility"
                },
                "number": {
                    "description": "Format the column’s values as numbers.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "currency": {
                    "description": "Format the column’s values as currency, using the host app’s `currencyCode` config.",
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "unit": {
                    "description": "Format the column’s values with `Intl.NumberFormat` unit style.",
                    "$ref": "./common.schema.json#/$defs/unitIdentifier"
                },
                "date": {
                    "description": "Format the column’s values as dates.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "datetime": {
                    "description": "Format the column’s values as date + time.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "phone": {
                    "description": "Format the column’s values as phone numbers.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "time": {
                    "description": "Read the column’s values as seconds and render them as `HH:mm:ss`. Integers only; negatives allowed.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "slice": {
                    "$ref": "./common.schema.json#/$defs/slice"
                },
                "uppercase": {
                    "description": "Upper-case the rendered values.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "lowercase": {
                    "description": "Lower-case the rendered values.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "capitalize": {
                    "description": "Capitalise the first letter of the rendered values.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "object": {
                    "description": "Treat the column’s values as objects.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "raw": {
                    "description": "Render the column’s values as raw HTML. Sanitised before rendering.",
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "class": {
                    "description": "CSS classes on the heading cell.",
                    "$ref": "./common.schema.json#/$defs/cssClass"
                },
                "style": {
                    "description": "Inline CSS on the heading cell.",
                    "$ref": "./common.schema.json#/$defs/style"
                },
                "type": {
                    "$ref": "./common.schema.json#/$defs/cellType"
                }
            },
            "required": ["content"],
            "patternProperties": {
                "^data-": {
                    "$ref": "./common.schema.json#/$defs/dataAttributeValue"
                }
            },
            "additionalProperties": true,
            "allOf": [
                {
                    "title": "field and fields are mutually exclusive",
                    "not": {
                        "required": ["field", "fields"]
                    }
                },
                {
                    "title": "fields requires an explicit key",
                    "if": {
                        "required": ["fields"]
                    },
                    "then": {
                        "required": ["key"]
                    }
                },
                {
                    "title": "a cell without field/fields must be a grouping cell",
                    "if": {
                        "allOf": [
                            {
                                "not": {
                                    "required": ["field"]
                                }
                            },
                            {
                                "not": {
                                    "required": ["fields"]
                                }
                            }
                        ]
                    },
                    "then": {
                        "required": ["colspan"],
                        "properties": {
                            "colspan": {
                                "minimum": 2
                            }
                        }
                    }
                }
            ]
        },
        "headerSettings": {
            "description": "Header-wide settings.",
            "type": "object",
            "properties": {
                "sticky": {
                    "description": "Keep the header fixed to the top of the scroll container.",
                    "$ref": "./common.schema.json#/$defs/flag"
                },
                "height": {
                    "description": "Fixed header height.",
                    "$ref": "./common.schema.json#/$defs/cssSize"
                },
                "searchableItems": {
                    "description": "Fields the toolbar’s global search covers. Every entry must match the `field` of some header cell — an unknown field is a validation error.",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    },
    "$ref": "#/$defs/header"
}
