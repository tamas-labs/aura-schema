{
    "header": {
        "rows": [
            {
                "cells": [
                    {
                        "content": null,
                        "key": "id",
                        "field": "id",
                        "selectable": true,
                        "width": "40px"
                    },
                    { "content": "User", "colspan": 2, "align": "center" },
                    { "content": "Account", "colspan": 3, "align": "center" }
                ]
            },
            {
                "cells": [
                    {
                        "content": "#",
                        "key": "id",
                        "field": "id",
                        "sortable": true,
                        "width": "80px",
                        "align": "end"
                    },
                    {
                        "content": "Name",
                        "key": "full_name",
                        "fields": ["first_name", "last_name"],
                        "sortable": true,
                        "searchable": true,
                        "reference": "last_name"
                    },
                    {
                        "content": "Status",
                        "key": "status",
                        "field": "status",
                        "filterable": true,
                        "elements": { "active": "Active", "suspended": "Suspended" },
                        "align": "center"
                    },
                    {
                        "content": "Balance",
                        "key": "balance",
                        "field": "balance",
                        "sortable": true,
                        "between": true,
                        "currency": true,
                        "align": "end",
                        "monospace": true
                    },
                    {
                        "content": "Created",
                        "key": "created_at",
                        "field": "created_at",
                        "sortable": true,
                        "datetime": true,
                        "data-testid": "created-column"
                    }
                ]
            }
        ],
        "settings": {
            "sticky": true,
            "height": "48px",
            "searchableItems": ["status", "created_at"]
        }
    },
    "body": {
        "settings": { "striped": true, "hoverable": true },
        "columnStyles": { "created_at": "text-nowrap" },
        "rowRules": {
            "key": "status",
            "if": [{ "eq": "suspended", "background": "danger-subtle", "opacity": 0.7 }]
        },
        "columnConfigs": {
            "full_name": {
                "type": "reference",
                "fields": ["first_name", "last_name"],
                "separator": " ",
                "capitalize": true
            },
            "status": {
                "type": "badge",
                "field": "status",
                "pill": true,
                "mapping": {
                    "active": { "label": "Active", "variant": "success", "icon": "check" },
                    "suspended": { "label": "Suspended", "variant": "danger", "icon": "ban" }
                }
            },
            "balance": {
                "type": "static",
                "key": "balance",
                "currency": true,
                "align": "end",
                "if": [
                    { "lt": 0, "color": "danger" },
                    { "gte": 0, "color": "success" }
                ]
            },
            "edit_icon": {
                "type": "icon",
                "key": "id",
                "icon": "edit",
                "variant": "primary",
                "title": "Edit user",
                "alt": "Edit user",
                "route": "users/{id}/edit"
            },
            "destroy_icon": {
                "type": "modal",
                "id": "destroyModal",
                "key": "id",
                "route": "users/{id}/destroy",
                "content": {
                    "type": "icon",
                    "icon": "trash",
                    "variant": "danger",
                    "alt": "Delete user"
                }
            }
        }
    },
    "footer": {
        "rows": [
            {
                "cells": [
                    { "content": "Total", "colspan": 4, "align": "end", "fontWeight": 700 },
                    {
                        "content": "12 480.00",
                        "key": "balance_total",
                        "field": "balance_total",
                        "align": "end",
                        "monospace": true
                    }
                ]
            }
        ],
        "settings": { "sticky": true }
    },
