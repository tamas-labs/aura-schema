{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/tamas-labs/aura-schema/main/schema/column-configs/custom.schema.json",
    "title": "Aura `custom` column config",
    "description": "Escape hatch. `renderer` and `callback` name functions in the host app’s function registry — the response carries the name only, never code. `template` is an interpolated string. With none of them, the cell falls back to rendering `field` / `fields` / `value`.",
    "$defs": {
        "customTemplateParams": {
            "description": "Template parameters for one `mapping` entry: `name: value` pairs substituted into `template`.",
            "type": "object",
            "propertyNames": {
                "type": "string"
            },
            "additionalProperties": {
                "anyOf": [
                    {
                        "type": "string",
                        "maxLength": 2000
                    },
                    {
                        "type": "number"
                    },
                    {
                        "type": "boolean"
                    },
                    {
                        "type": "null"
                    }
                ]
            }
        },
        "customConfig": {
            "description": "Escape hatch. `renderer` and `callback` name functions in the host app’s function registry — the response carries the name only, never code. `template` is an interpolated string. With none of them, the cell falls back to rendering `field` / `fields` / `value`.",
            "type": "object",
            "properties": {
                "type": {
                    "description": "Discriminator. Selects the custom renderer.",
                    "type": "string",
                    "const": "custom"
                },
                "field": {
                    "description": "Item field holding the value.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "fields": {
                    "description": "Several item fields passed to the renderer.",
                    "anyOf": [
                        {
                            "minItems": 1,
                            "maxItems": 50,
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 250
                            }
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "value": {
                    "description": "Fixed text.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 5000
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "renderer": {
                    "description": "Name of a function in the host app’s function registry that returns the rendered node.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "callback": {
                    "description": "Name of a function in the host app’s function registry that returns the text to render.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "template": {
                    "description": "Template string; `{placeholder}` tokens are filled from the row and from `params`.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10000
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "params": {
                    "description": "Extra values available to `template` and to the registered functions.",
                    "anyOf": [
                        {
                            "type": "object",
                            "propertyNames": {
                                "type": "string"
                            },
                            "additionalProperties": {}
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "mapping": {
                    "description": "Value → template-parameter lookup, keyed by the resolved value.",
                    "anyOf": [
                        {
                            "type": "object",
                            "propertyNames": {
                                "type": "string"
                            },
                            "additionalProperties": {
                                "$ref": "#/$defs/customTemplateParams"
                            }
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "color": {
                    "description": "Text colour of the rendered content.",
                    "$ref": "../common.schema.json#/$defs/bootstrapColor"
                },
                "background": {
                    "description": "Background colour behind the rendered content.",
                    "$ref": "../common.schema.json#/$defs/color"
                },
                "align": {
                    "description": "Alignment of the rendered content.",
                    "$ref": "../common.schema.json#/$defs/align"
                },
                "fontSize": {
                    "description": "Font size of the rendered content.",
                    "$ref": "../common.schema.json#/$defs/fontSize"
                },
                "fontWeight": {
                    "description": "Font weight of the rendered content.",
                    "$ref": "../common.schema.json#/$defs/fontWeight"
                },
                "italic": {
                    "description": "Italic text.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "normal": {
                    "description": "Reset italics (`font-style: normal`).",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "lineHeight": {
                    "description": "Line height of the rendered content.",
                    "$ref": "../common.schema.json#/$defs/lineHeight"
                },
                "text": {
                    "description": "Bootstrap text utility class on the rendered content.",
                    "$ref": "../common.schema.json#/$defs/textUtility"
                },
                "uppercase": {
                    "description": "Upper-case the rendered text.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "lowercase": {
                    "description": "Lower-case the rendered text.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "capitalize": {
                    "description": "Capitalise the first letter of the rendered text.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "monospace": {
                    "description": "Monospace font.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "slice": {
                    "description": "Truncate the rendered text to this many characters.",
                    "$ref": "../common.schema.json#/$defs/slice"
                },
                "number": {
                    "description": "Format the value as a number.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "currency": {
                    "description": "Format the value as currency, using the host app’s `currencyCode` config.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "date": {
                    "description": "Format the value as a date.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "phone": {
                    "description": "Format the value as a phone number.",
                    "$ref": "../common.schema.json#/$defs/flag"
                },
                "unit": {
                    "description": "Unit appended to the formatted value.",
                    "$ref": "../common.schema.json#/$defs/contentUnit"
                },
                "padStart": {
                    "description": "Pad the rendered text to this length on the left, with `chars`.",
                    "$ref": "../common.schema.json#/$defs/pad"
                },
                "padEnd": {
                    "description": "Pad the rendered text to this length on the right, with `chars`.",
                    "$ref": "../common.schema.json#/$defs/pad"
                },
                "chars": {
                    "description": "Character(s) used for padding.",
                    "$ref": "../common.schema.json#/$defs/chars"
                },
                "class": {
                    "description": "CSS classes on the rendered element.",
                    "$ref": "../common.schema.json#/$defs/cssClass"
                },
                "style": {
                    "description": "Inline CSS on the rendered element.",
                    "$ref": "../common.schema.json#/$defs/style"
                },
                "cellRules": {
                    "description": "Conditional styling for the `<td>`.",
                    "$ref": "../common.schema.json#/$defs/cellRules"
                },
                "key": {
                    "description": "Item field the `if` conditions read, and the field substituted into `{key}` placeholders in `route`. Defaults to the column key.",
                    "anyOf": [
                        {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 250
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "if": {
                    "description": "Condition branches; the first matching one is merged over this config.",
                    "anyOf": [
                        {
                            "type": "array",
                            "items": {
                                "$ref": "../common.schema.json#/$defs/conditionalRule"
                            }
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "else": {
                    "description": "Config merged in when no `if` branch matched.",
                    "anyOf": [
                        {
                            "type": "object",
                            "additionalProperties": true
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": ["type"],
            "patternProperties": {
                "^data-": {
                    "$ref": "../common.schema.json#/$defs/dataAttributeValue"
                }
            },
            "additionalProperties": true,
            "allOf": [
                {
                    "title": "One of `renderer`, `callback`, `template`, `field`, `fields` or `value` is required — unless `if` or `else` branches are given",
                    "anyOf": [
                        {
                            "required": ["renderer"]
                        },
                        {
                            "required": ["callback"]
                        },
                        {
                            "required": ["template"]
                        },
                        {
                            "required": ["field"]
                        },
                        {
                            "required": ["fields"]
                        },
                        {
                            "required": ["value"]
                        },
                        {
                            "required": ["if"]
                        },
                        {
                            "required": ["else"]
                        }
                    ]
                }
            ]
        }
    },
    "$ref": "#/$defs/customConfig"
}
